# Same variable names as the Express API (nexorarent/.env.example), so both
# services can share one configuration while routes are migrated.

DB_HOST=localhost
DB_PORT=3307
DB_NAME=drenas_rentacar
DB_USER=nexorarent
DB_PASSWORD=replace_with_the_same_password_as_the_express_api

# Must be the same value as in the Express API so its access tokens validate here.
JWT_SECRET=your_64_char_random_secret_here

# Comma-separated list of frontend origins allowed to call this API with cookies.
CLIENT_URL=http://localhost:3000
