# Same variable names as the Express API (nexorarent/.env.example), so both
# services can share one configuration while routes are migrated.

DB_HOST=localhost
DB_PORT=3307
DB_NAME=drenas_rentacar
DB_USER=nexorarent
DB_PASSWORD=replace_with_the_same_password_as_the_express_api

# Must be the same values as in the Express API so tokens work on both. In production both are
# required, at least 32 characters, and different from each other.
JWT_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=a_different_64_char_random_secret_here

# Comma-separated list of frontend origins allowed to call this API with cookies.
CLIENT_URL=http://localhost:3000

# SameSite for the refreshToken cookie: lax (default), strict or none (none needs HTTPS).
COOKIE_SAME_SITE=lax
